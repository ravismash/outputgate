{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["survey_id", "closed_on", "total_responses", "options"],
  "additionalProperties": false,
  "properties": {
    "survey_id": {"type": "string"},
    "closed_on": {"type": "string"},
    "total_responses": {"type": "integer", "minimum": 0},
    "options": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["label", "count", "share"],
        "additionalProperties": false,
        "properties": {
          "label": {"type": "string"},
          "count": {"type": "integer", "minimum": 0},
          "share": {"type": "number"}
        }
      }
    }
  }
}
