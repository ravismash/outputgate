{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["vendor", "subtotal", "line_items"],
  "additionalProperties": false,
  "properties": {
    "vendor": { "type": "string" },
    "currency": { "type": "string" },
    "subtotal": { "type": "number" },
    "line_items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["amount"],
        "properties": {
          "description": { "type": "string" },
          "amount": { "type": "number" }
        }
      }
    }
  }
}
